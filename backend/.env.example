# Choose one provider. If both are set, DashScope is used first.
# Leave unused credentials empty; do not use placeholder strings as real keys.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
# LLM_INTENT_DISABLE_LLM=1

# AMap / Gaode Web service (server only)
AMAP_WEB_KEY=
AMAP_WEB_BASE_URL=https://restapi.amap.com
AMAP_WEB_TIMEOUT_SECONDS=20
# Browser JS SDK gateway. Separate JS API credentials; server-side only.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# Shared travel task service
TRAVEL_PRODUCTION=1
TRAVEL_TASK_TIMEOUT=180
# Business admission limits, per API instance with persisted quota windows.
# Planning/draft/adjust/retry share 300 seconds; REST data tools/check share 60.
TRAVEL_LIMIT_TASKS=20
TRAVEL_LIMIT_TASKS_GLOBAL=60
TRAVEL_LIMIT_ACTIVE_TASKS=3
TRAVEL_LIMIT_TOOLS=60
TRAVEL_LIMIT_TOOLS_GLOBAL=180
TRAVEL_LIMIT_TOOL_CHECKS=3
TRAVEL_TOOL_CONCURRENCY=4
TRAVEL_LIMIT_STREAMS=3
TRAVEL_LIMIT_STREAMS_GLOBAL=30
# Data tools run in this backend only. 'mcp' uses the bundled stdio server;
# install requirements.mcp.txt first. A failed MCP call never falls back.
TRAVEL_TOOL_TRANSPORT=direct
TRAVEL_MCP_CONNECT_TIMEOUT=8
TRAVEL_MCP_CALL_TIMEOUT=12
TRAVEL_MCP_TOTAL_TIMEOUT=150
TRAVEL_MCP_MAX_CALLS=64
TRAVEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# local preserves the original local workspace. session enables user isolation;
# create accounts with python -m travel.accounts create <username> in backend/.
TRAVEL_AUTH_MODE=local
TRAVEL_SESSION_TTL=28800
TRAVEL_SESSION_IDLE_TTL=1800
# Use 1 behind a correctly configured HTTPS deployment; 0 is for localhost HTTP.
TRAVEL_COOKIE_SECURE=0
# TRAVEL_DB_PATH=D:/jupyter/MT/backend/data/travel.sqlite3

# Optional HelloAgents intake (install requirements.helloagents.txt first).
# Disabled by default; extraction only, never auto-submit a travel plan.
# Set LLM_INTENT_DISABLE_LLM=0 as well when explicitly enabling intake.
TRAVEL_AGENT_ENABLED=0
# Reuses existing DASHSCOPE_* or OPENAI_* server credentials when enabled.
# Or explicitly configure one OpenAI-compatible server:
# TRAVEL_LLM_API_KEY=
# TRAVEL_LLM_BASE_URL=https://your-model-server/v1
# TRAVEL_LLM_MODEL=

# Shared across REST, task workers and bundled MCP; no automatic upstream retries.
# Defaults pace this installation, not all programs using the same Amap account.
TRAVEL_AMAP_MIN_INTERVAL_SECONDS=1
TRAVEL_AMAP_MAX_WAIT_SECONDS=3
TRAVEL_AMAP_COOLDOWN_SECONDS=5
# Optional absolute path. Default: amap-rate.sqlite3 beside TRAVEL_DB_PATH.
# TRAVEL_AMAP_RATE_DB_PATH=/var/lib/travelagent/amap-rate.sqlite3

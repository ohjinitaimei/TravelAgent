# Public gateway settings only. Replace the example domain.
TRAVEL_SITE=https://travel.example.com
TRAVEL_HTTP_SITE=http://travel.example.com
TRAVEL_UPSTREAM=127.0.0.1:8000
TRAVEL_WEB_ROOT=/opt/travelagent/apps/web/dist
TRAVEL_CADDY_ADMIN=127.0.0.1:2019
TRAVEL_BIND=0.0.0.0
TRAVEL_CADDY_DATA=/var/lib/caddy/travelagent
# Public deployment leaves this empty; no internal CA for public domains.
TRAVEL_TLS=

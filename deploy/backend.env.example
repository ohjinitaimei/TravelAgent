# Copy to /etc/travelagent/backend.env; secrets never go into gateway.env.
TRAVEL_PRODUCTION=1
TRAVEL_AUTH_MODE=session
TRAVEL_COOKIE_SECURE=1
TRAVEL_CORS_ORIGINS=https://travel.example.com
TRAVEL_DB_PATH=/var/lib/travelagent/travel.sqlite3
TRAVEL_TASK_TIMEOUT=180
TRAVEL_SESSION_TTL=28800
TRAVEL_SESSION_IDLE_TTL=1800
TRAVEL_LIMIT_TASKS=20
TRAVEL_LIMIT_TASKS_GLOBAL=60
TRAVEL_LIMIT_ACTIVE_TASKS=3
TRAVEL_LIMIT_TOOLS=60
TRAVEL_LIMIT_TOOLS_GLOBAL=180
TRAVEL_LIMIT_TOOL_CHECKS=3
TRAVEL_TOOL_CONCURRENCY=4
TRAVEL_LIMIT_STREAMS=3
TRAVEL_LIMIT_STREAMS_GLOBAL=30
TRAVEL_TOOL_TRANSPORT=direct
TRAVEL_AGENT_ENABLED=0
LLM_INTENT_DISABLE_LLM=1
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

{
	admin {$TRAVEL_CADDY_ADMIN:127.0.0.1:2019}
	auto_https disable_redirects
	persist_config off
	storage file_system {$TRAVEL_CADDY_DATA:/var/lib/caddy/travelagent}
	skip_install_trust
}

{$TRAVEL_SITE} {
	bind {$TRAVEL_BIND:0.0.0.0}
	# Empty for public ACME; isolated local acceptance sets "tls internal".
	{$TRAVEL_TLS}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 64KB
	}
	@api path /api /api/* /health/*
	handle @api {
		reverse_proxy {$TRAVEL_UPSTREAM:127.0.0.1:8000} {
			flush_interval -1
			# Overwrite forwarded identity at this directly exposed edge.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up -Forwarded
			transport http {
				dial_timeout 3s
				response_header_timeout 20s
			}
		}
	}
	handle /assets/* {
		root * {$TRAVEL_WEB_ROOT}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * {$TRAVEL_WEB_ROOT}
		header Cache-Control no-cache
		# The Web uses hash navigation; missing files must remain 404.
		file_server
	}
	handle_errors {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"error":{"code":"gateway_rejected","message":"入口请求未能完成","retryable":false}}` {err.status_code}
	}
}

{$TRAVEL_HTTP_SITE} {
	bind {$TRAVEL_BIND:0.0.0.0}
	redir {$TRAVEL_SITE}{uri} 308
}
